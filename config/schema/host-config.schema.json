{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opspilot.local/schema/host-config.schema.json",
  "title": "OpsPilot Host Configuration",
  "description": "Declarative baseline for a managed Windows host (FR-001, AP-6). Non-secret values only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "host", "network"],
  "properties": {
    "version": { "const": "1" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "os_family", "timezone"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,62}$" },
        "os_family": { "const": "windows" },
        "timezone": { "type": "string", "minLength": 1 },
        "admin_account": { "type": "string", "minLength": 1 },
        "rdp_enabled": { "type": "boolean", "default": false },
        "service_account": { "type": "string", "minLength": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_inbound_tcp_ports", "metrics_scrape_cidrs"],
      "properties": {
        "allowed_inbound_tcp_ports": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "uniqueItems": true
        },
        "metrics_scrape_cidrs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$" },
          "uniqueItems": true
        },
        "dns_servers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
